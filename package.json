{
  "name": "sync-it-simply-stupid",
  "version": "0.9.8",
  "description": "Personal Obsidian sync plugin for your own cloud storage.",
  "scripts": {
    "dev2": "node esbuild.config.mjs --watch",
    "build2": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "format": "npx @biomejs/biome check --write .",
    "clean": "npx rimraf main.js",
    "test": "mocha --import=tsx --require=./tests/support/register-obsidian-stub.cjs 'tests/**/*.test.ts'",
    "audit:check": "node scripts/check-audit.mjs"
  },
  "browser": {
    "path": "path-browserify",
    "process": "process/browser",
    "stream": "stream-browserify",
    "crypto": false,
    "url": "url/",
    "fs": false,
    "vm": false
  },
  "source": "main.ts",
  "keywords": [],
  "author": "pskrebnev",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@types/chai": "^4.3.16",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/mime-types": "^2.1.4",
    "@types/mocha": "^10.0.7",
    "@types/mustache": "^4.2.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "builtin-modules": "^4.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3",
    "npm-check-updates": "^23.1.1",
    "obsidian": "^1.5.7",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.5.1",
    "tslib": "^2.6.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "webdav-server": "^2.6.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/types": "^3.609.0",
    "@fyears/rclone-crypt": "^0.0.7",
    "@fyears/tsqueue": "^1.0.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@smithy/fetch-http-handler": "^3.2.4",
    "@smithy/protocol-http": "^4.1.0",
    "@smithy/querystring-builder": "^4.5.2",
    "acorn": "^8.12.1",
    "aggregate-error": "^5.1.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "dropbox": "^10.34.0",
    "emoji-regex": "^11.0.0",
    "http-status-codes": "^2.3.0",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "localforage-removeitems": "^1.4.0",
    "lodash": "^4.17.21",
    "lucide": "^0.416.0",
    "mime-types": "^2.1.35",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.7",
    "p-queue": "^9.3.5",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.3",
    "rfc4648": "^1.5.3",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webdav": "^5.6.0",
    "xregexp": "^5.1.1"
  },
  "overrides": {
    "clean-stack": "5.2.0"
  }
}
